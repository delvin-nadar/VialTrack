rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Tasks collection: Diagnostic sample pickups & deliveries
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if true;
    }

    // Attendance collection: Rider attendance & check-in logs
    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if true;
    }

    // Clients collection: Diagnostic labs & hospitals
    match /clients/{clientId} {
      allow read: if true;
      allow write: if true;
    }

    // Riders collection: Field pickup agents
    match /riders/{riderId} {
      allow read: if true;
      allow write: if true;
    }

    // Routes collection: Defined sample collection routes
    match /routes/{routeId} {
      allow read: if true;
      allow write: if true;
    }

    // Locations collection: Live GPS pings
    match /locations/{locationId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings collection: Global organization settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Test connection doc for initial boot validation
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
